{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sites.schema.json",
  "title": "sites.json — candidate landing sites (see types.ts SitesFile). v1.1 adds optional region, kind, group, checks, pending_metrics and extra metrics.",
  "type": "object",
  "required": ["version", "mock", "generated_utc", "weights", "sites"],
  "properties": {
    "version": { "const": 1 },
    "mock": { "type": "boolean" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "weights": {
      "type": "object",
      "required": ["illum_pct", "earth_vis_pct", "slope_deg", "max_dark_hours", "psr_dist_km"],
      "additionalProperties": { "type": "number" }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lat", "lon", "elev_m", "valid", "score", "metrics", "reasons"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "elev_m": { "type": "number" },
          "valid": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "metrics": {
            "type": "object",
            "required": [
              "illum_pct",
              "earth_vis_pct",
              "slope_deg",
              "max_dark_hours",
              "psr_dist_km"
            ],
            "properties": {
              "illum_pct": { "type": "number", "minimum": 0, "maximum": 1 },
              "earth_vis_pct": { "type": "number", "minimum": 0, "maximum": 1 },
              "slope_deg": { "type": "number", "minimum": 0, "maximum": 90 },
              "max_dark_hours": { "type": "number", "minimum": 0 },
              "psr_dist_km": { "type": "number", "minimum": 0 },
              "sun_el_mean_deg": { "type": "number", "minimum": 0, "maximum": 90 },
              "max_blackout_hours": { "type": "number", "minimum": 0 },
              "sun_earth_pct": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" },
          "region": { "enum": ["south_pole", "north_pole", "near_side", "far_side"] },
          "kind": { "enum": ["candidate", "historic_landing"] },
          "group": { "type": "string" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "ok", "value", "threshold", "margin"],
              "properties": {
                "key": {
                  "enum": [
                    "illum_pct",
                    "earth_vis_pct",
                    "slope_deg",
                    "max_dark_hours",
                    "psr_dist_km",
                    "sun_el_mean_deg",
                    "max_blackout_hours",
                    "sun_earth_pct"
                  ]
                },
                "ok": { "type": "boolean" },
                "value": { "type": ["number", "null"] },
                "threshold": { "type": "number" },
                "objective": { "type": "number" },
                "margin": { "type": ["number", "null"] },
                "pending": { "type": "boolean" }
              }
            }
          },
          "pending_metrics": {
            "type": "array",
            "items": {
              "enum": [
                "illum_pct",
                "earth_vis_pct",
                "slope_deg",
                "max_dark_hours",
                "psr_dist_km",
                "sun_el_mean_deg",
                "max_blackout_hours",
                "sun_earth_pct"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

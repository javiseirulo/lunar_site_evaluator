{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layers.schema.json",
  "title": "layers.json — raster overlays in south polar stereographic (see types.ts LayersManifest)",
  "type": "object",
  "required": [
    "version",
    "mock",
    "projection",
    "radius_m",
    "bounds_m",
    "lat_limit",
    "width_px",
    "height_px",
    "layers"
  ],
  "properties": {
    "version": { "const": 1 },
    "mock": { "type": "boolean" },
    "projection": { "type": "string" },
    "radius_m": { "type": "number" },
    "bounds_m": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "lat_limit": { "type": "number", "minimum": -90, "maximum": 0 },
    "width_px": { "type": "integer" },
    "height_px": { "type": "integer" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "file",
          "encoding",
          "kind",
          "units",
          "value_range",
          "palette",
          "default_visible",
          "default_opacity",
          "description",
          "source"
        ],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "file": { "type": "string" },
          "encoding": { "enum": ["gray8", "gray16"] },
          "kind": { "enum": ["continuous", "categorical"] },
          "units": { "type": "string" },
          "value_range": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "string" }],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "categories": { "type": "object", "additionalProperties": { "type": "string" } },
          "default_visible": { "type": "boolean" },
          "default_opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}

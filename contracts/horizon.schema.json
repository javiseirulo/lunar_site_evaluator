{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon.schema.json",
  "title": "horizon/<site_id>.json — terrain horizon profile (see types.ts HorizonProfile). elev_deg[i] = horizon elevation at azimuth i·az_step_deg, clockwise from local north, curvature included.",
  "type": "object",
  "required": [
    "version",
    "site_id",
    "lat",
    "lon",
    "observer_height_m",
    "az_step_deg",
    "elev_deg",
    "max_range_km",
    "source"
  ],
  "properties": {
    "version": { "const": 1 },
    "site_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "observer_height_m": { "type": "number", "minimum": 0 },
    "az_step_deg": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
    "elev_deg": {
      "type": "array",
      "minItems": 36,
      "items": { "type": "number", "minimum": -90, "maximum": 90 }
    },
    "max_range_km": { "type": "number", "exclusiveMinimum": 0 },
    "source": { "type": "string", "minLength": 1 }
  }
}

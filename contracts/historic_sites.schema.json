{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historic_sites.schema.json",
  "title": "historic_sites.json — past lunar landings and impacts (see types.ts HistoricSitesFile). Ids match sites.json historic_landing ids when the mission is in the catalog.",
  "type": "object",
  "required": ["version", "generated_utc", "sites"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "generated_utc": { "type": "string", "format": "date-time" },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "agency",
          "country",
          "date_utc",
          "lat",
          "lon",
          "outcome",
          "kind",
          "note",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "agency": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "date_utc": { "type": "string", "format": "date-time" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "outcome": { "enum": ["success", "partial", "failed"] },
          "kind": { "enum": ["lander", "rover", "crewed", "sample_return", "impact"] },
          "note": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}

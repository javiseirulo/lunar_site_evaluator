# Optional deployment-specific PUBLIC Cesium ion application token.
# Ask Pablo for the project's read-only Moon application token; no personal ion account is needed.
# Vite exposes this value in the browser: never use private ion scopes.
# Copy to web/.env.local if an override is needed; .env.local is ignored by Git.
VITE_CESIUM_ION_TOKEN=

# Class mode ("Try with class"): Firebase Realtime Database web config. PUBLIC values (they are
# not secrets: access is controlled by /database.rules.json). The code already has defaults for
# project glossy-monitor-514715-k4, so these are only needed to point at another Firebase project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
